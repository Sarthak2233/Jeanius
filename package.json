{
  "name": "jeanius-and-jewl",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "diagrams:generate": "node --experimental-strip-types scripts/generate-diagrams.ts",
    "setup:env": "bash scripts/setup-env.sh",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:push": "pnpm --filter @jeanius/database db:push",
    "db:seed": "pnpm --filter @jeanius/database seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.117.2",
    "@types/node": "^22.13.5",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.5.2",
    "supabase": "^2.119.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1"
  }
}
