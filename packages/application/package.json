{
  "name": "@jeanius/application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./catalog": {
      "types": "./src/catalog/index.ts",
      "import": "./src/catalog/index.ts"
    },
    "./cart": {
      "types": "./src/cart/index.ts",
      "import": "./src/cart/index.ts"
    },
    "./order": {
      "types": "./src/order/index.ts",
      "import": "./src/order/index.ts"
    },
    "./payment": {
      "types": "./src/payment/index.ts",
      "import": "./src/payment/index.ts"
    },
    "./production": {
      "types": "./src/production/index.ts",
      "import": "./src/production/index.ts"
    },
    "./inventory": {
      "types": "./src/inventory/index.ts",
      "import": "./src/inventory/index.ts"
    },
    "./fulfillment": {
      "types": "./src/fulfillment/index.ts",
      "import": "./src/fulfillment/index.ts"
    },
    "./community": {
      "types": "./src/community/index.ts",
      "import": "./src/community/index.ts"
    },
    "./content": {
      "types": "./src/content/index.ts",
      "import": "./src/content/index.ts"
    },
    "./audit": {
      "types": "./src/audit/index.ts",
      "import": "./src/audit/index.ts"
    },
    "./auth": {
      "types": "./src/auth/index.ts",
      "import": "./src/auth/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo \"@jeanius/application linted\"",
    "build": "echo \"@jeanius/application ready\"",
    "test": "npx tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@jeanius/domain": "workspace:*",
    "@jeanius/contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
