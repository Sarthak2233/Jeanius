# ==============================================================================
# JEANIUS PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in your Supabase credentials (from https://supabase.com/dashboard)
#    OR use the local Docker defaults provided below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CREDENTIALS (Required for State 05: Auth & Security)
# ------------------------------------------------------------------------------

# Supabase Project API URL
# - Hosted: https://<project-ref>.supabase.co
# - Local Docker: http://localhost:54321
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (Safe for browser / client-side Next.js code)
# - Hosted: Dashboard -> Project Settings -> API -> "anon" "public" key
# - Local Docker: default anon key from `npx supabase status`
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Secret Key (SERVER ONLY - NEVER expose to browser!)
# Used by Next.js Server Actions to bypass RLS, create admin profiles, and seed.
# - Hosted: Dashboard -> Project Settings -> API -> "service_role" key (Reveal)
# - Local Docker: default service_role key from `npx supabase status`
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Supabase JWT Secret (Used for server-side token validation)
# - Hosted: Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ------------------------------------------------------------------------------
# 2. DATABASE CONNECTIONS (Drizzle ORM & Migrations)
# ------------------------------------------------------------------------------

# Transaction Mode Connection Pooler (Port 6543) — Used by Next.js Serverless runtime:
# postgres://postgres.<project-ref>:[DB-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# Local Docker: postgres://postgres:postgres@localhost:54322/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# Direct Session Mode Connection (Port 5432) — Reserved for database migrations & DDL:
# postgres://postgres.<project-ref>:[DB-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
# Local Docker: postgres://postgres:postgres@localhost:54322/postgres
DIRECT_URL=postgres://postgres:postgres@localhost:54322/postgres

# ------------------------------------------------------------------------------
# 3. SITE URL & APPLICATION HOSTING
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NODE_ENV=development

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAYS (Required in State 09 — Placeholders for now)
# ------------------------------------------------------------------------------
# Stripe (International)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# Domestic Payment Gateways (Nepal - eSewa & Khalti)
ESEWA_MERCHANT_CODE=EPAYTEST
KHALTI_SECRET_KEY=test_secret_key_placeholder
