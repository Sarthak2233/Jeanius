stateDiagram-v2
    [*] --> QUEUED: Order Paid (Bench Job Created)
    
    state "Kathmandu Workshop Dispatch" as dispatch {
        QUEUED
    }
    
    QUEUED --> CASTING: Metal Allocated & Investment Burnout (Point of No Return)
    
    state "Jewellery Bench Pipeline" as jewl {
        CASTING --> SETTING: Cast cooled, sprues removed & trued on mandrel
        SETTING --> PATINA: Sizing verified, engraving & bezel stone set
        PATINA --> POLISHING: Surface oxidized/tempered with liver of sulfur
        POLISHING --> QC: Multi-stage rouge buffing (Mirror / Matte)
    }
    
    QC --> READY: Tolerance, hallmark stamp & finish inspection passed
    QC --> SETTING: Bench Rework (Resizing / Refinishing)
    
    READY --> SHIPPED: Cleaned in ultrasonic bath & packaged in atelier box
    SHIPPED --> [*]

    classDef queued fill:#0f172a,stroke:#64748b,stroke-width:1.5px,color:#f8fafc;
    classDef casting fill:#4c0519,stroke:#f43f5e,stroke-width:2px,color:#ffe4e6;
    classDef setting fill:#1e1b4b,stroke:#6366f1,stroke-width:2px,color:#e0e7ff;
    classDef patina fill:#451a03,stroke:#f59e0b,stroke-width:2px,color:#fef3c7;
    classDef polishing fill:#083344,stroke:#06b6d4,stroke-width:2px,color:#cffafe;
    classDef qc fill:#064e3b,stroke:#10b981,stroke-width:2px,color:#d1fae5;
    classDef ready fill:#065f46,stroke:#34d399,stroke-width:2px,color:#ecfdf5;
    classDef shipped fill:#1e293b,stroke:#38bdf8,stroke-width:2px,color:#f0f9ff;

    class QUEUED queued;
    class CASTING casting;
    class SETTING setting;
    class PATINA patina;
    class POLISHING polishing;
    class QC qc;
    class READY ready;
    class SHIPPED shipped;
