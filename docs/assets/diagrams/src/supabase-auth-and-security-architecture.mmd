graph TD
    subgraph ClientAndDelivery["Delivery Runtimes (Next.js App Router)"]
        Storefront["apps/storefront<br/>• Public Catalog & Cart<br/>• /account/* (Customer)<br/>• /member/* (VIP Drops)"]
        Admin["apps/admin<br/>• /workshop/tailor (Denim)<br/>• /workshop/jeweller (Jewellery)<br/>• /fulfillment & /support<br/>• /financials & /settings (Admin)"]
        StoreMiddleware["Storefront Middleware<br/>• Session Token Refresh<br/>• Account & Member Guard"]
        AdminMiddleware["Admin RBAC Middleware<br/>• Sub-path Role Gating<br/>• Tailor vs Jeweller Isolation"]
    end

    subgraph AppUseCases["Application Layer (packages/application)"]
        AuthCases["Auth & Session Use Cases<br/>• SignUpUseCase / LoginUseCase<br/>• LogoutUseCase / PasswordReset<br/>• GetSessionActorUseCase"]
        ProfileCases["Dual-Craft Profile Use Cases<br/>• Denim Sizing (Waist / Inseam)<br/>• Jewellery Sizing (Ring Mandrel / Alloy)<br/>• Address Management"]
        GuardRules["Authorization & Boundary Guards<br/>• assertActorHasRole(actor, allowedRoles)<br/>• assertPrePointOfNoReturn(category, stage)<br/>• checkMembershipAccess(memberId)"]
    end

    subgraph AdaptersAndStorage["Infrastructure & Persistence"]
        AuthGateway["packages/integrations<br/>• SupabaseAuthGateway (IAuthGateway)<br/>• SupabaseAdminClient (Service Role)"]
        DrizzleRepos["packages/database<br/>• DrizzleUserProfileRepository<br/>• DrizzleAddressRepository<br/>• DrizzleAuditLogRepository"]
        SupabaseAuthService["Supabase Auth Service<br/>• auth.users Table<br/>• JWT Access / Refresh Tokens<br/>• Email Verification & Password Recovery"]
        PostgresRLS["Supabase PostgreSQL (RLS Enabled)<br/>• users_profile (auth.uid = id)<br/>• orders & order_lines (customer_id)<br/>• production_jobs (TAILOR vs JEWELLER)<br/>• audit_logs (append-only, admin read)"]
    end

    Storefront --> StoreMiddleware
    Admin --> AdminMiddleware
    Storefront --> AuthCases
    Storefront --> ProfileCases
    Admin --> AuthCases
    Admin --> GuardRules

    AuthCases --> AuthGateway
    AuthCases --> DrizzleRepos
    ProfileCases --> DrizzleRepos
    GuardRules --> DrizzleRepos

    AuthGateway --> SupabaseAuthService
    DrizzleRepos --> PostgresRLS

