graph TD
    Spec["PRODUCT SPEC"] --> Contract["Product / Architecture Contract"]
    Contract --> Monorepo["Monorepo Foundation"]
    Contract --> Domain["Domain Model"]
    Contract --> Database["Database Schema"]

    Monorepo --> Auth["Auth & Contracts"]
    Domain --> Auth
    Database --> Auth

    Auth --> Storefront["Storefront App"]
    Auth --> Admin["Admin Operations"]
    Auth --> Integrations["Integrations & Adapters"]

    Storefront --> Catalog["Catalog"]
    Admin --> Operations["Operations"]
    Integrations --> Payments["Payments"]

    Catalog --> Configurator["Configurator"]
    Configurator --> Cart["Cart"]
    Cart --> Checkout["Checkout"]
    Operations --> Checkout
    Payments --> Checkout

    Checkout --> Order["Order Created"]
    Order --> OM["Order-Made (OM)"]
    Order --> DROP["DROP Pre-Made"]

    OM --> Manufacturing["Manufacturing Queue"]
    DROP --> Fulfillment["Fulfillment Staging"]

    Manufacturing --> Shipment["Shipment Dispatch"]
    Fulfillment --> Shipment

    Shipment --> Delivery["Carrier Delivery"]
    Delivery --> Review["Verified Review"]
    Delivery --> Support["Customer Support"]

    classDef indigo fill:#1e1b4b,stroke:#6366f1,stroke-width:2px,color:#e0e7ff;
    classDef cyan fill:#083344,stroke:#06b6d4,stroke-width:2px,color:#cffafe;
    classDef emerald fill:#064e3b,stroke:#10b981,stroke-width:2px,color:#d1fae5;
    classDef amber fill:#451a03,stroke:#f59e0b,stroke-width:2px,color:#fef3c7;
    classDef violet fill:#2e1065,stroke:#8b5cf6,stroke-width:2px,color:#ede9fe;
    classDef rose fill:#4c0519,stroke:#f43f5e,stroke-width:2px,color:#ffe4e6;

    class Spec,Contract,Monorepo indigo;
    class Domain,Database,Auth,Delivery emerald;
    class Storefront,Admin,Catalog,Configurator,Cart cyan;
    class Operations,Payments,Checkout,Order amber;
    class Integrations,OM,DROP,Manufacturing,Fulfillment,Shipment violet;
    class Review,Support rose;
